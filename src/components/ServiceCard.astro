---
type Props = {
  title: string;
  description: string;
  items?: string[];
};

const { title, description, items = [] } = Astro.props;
---

<article class="glass-card service-card" data-reveal>
  <h3>{title}</h3>
  <p>{description}</p>
  {
    items.length > 0 && (
      <ul class="detail-list">
        {items.map((item) => <li>{item}</li>)}
      </ul>
    )
  }
</article>
