---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="PulseNews Architecture" description="A location-aware, AI-powered news platform with real-time fake news detection">
  <style>
    .arch-hero {
      padding-top: 5.9rem;
      padding-bottom: 2rem;
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--muted-strong);
      font-size: 0.9rem;
      margin-bottom: 2rem;
      transition: color var(--transition);
    }

    .back-link:hover {
      color: var(--text);
    }

    .arch-header {
      text-align: center;
      max-width: 800px;
      margin: 0 auto 3rem;
    }

    .arch-header h1 {
      font-size: clamp(3rem, 6vw, 5rem);
      margin-bottom: 1rem;
    }

    .arch-header .subtitle {
      font-size: 1.1rem;
      color: var(--muted-strong);
      line-height: 1.6;
      margin-bottom: 2rem;
    }

    .tech-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      justify-content: center;
    }

    .tech-badge {
      padding: 0.5rem 1rem;
      border-radius: 999px;
      border: 1px solid rgba(114, 221, 255, 0.2);
      background: rgba(114, 221, 255, 0.08);
      color: var(--accent);
      font-size: 0.85rem;
      font-weight: 700;
    }

    .layer-section {
      padding: 3rem 0;
    }

    .layer-header {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 2rem;
    }

    .layer-number {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 3rem;
      height: 3rem;
      border-radius: 1rem;
      background: linear-gradient(135deg, rgba(114, 221, 255, 0.2), rgba(73, 177, 255, 0.2));
      border: 1px solid rgba(114, 221, 255, 0.3);
      font-family: "Sora", sans-serif;
      font-weight: 800;
      color: var(--accent);
    }

    .layer-header h2 {
      font-size: clamp(1.8rem, 3vw, 2.5rem);
    }

    .stack-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.25rem;
    }

    .stack-card {
      padding: 1.5rem;
      border-radius: 1.2rem;
      border: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(255, 255, 255, 0.02);
      transition: all var(--transition);
    }

    .stack-card:hover {
      border-color: rgba(114, 221, 255, 0.3);
      background: rgba(114, 221, 255, 0.05);
      transform: translateY(-2px);
    }

    .stack-card .icon {
      font-size: 2rem;
      margin-bottom: 1rem;
    }

    .stack-card h3 {
      font-size: 1.1rem;
      margin-bottom: 0.75rem;
    }

    .stack-card p {
      color: var(--muted);
      font-size: 0.9rem;
      margin-bottom: 0.75rem;
    }

    .stack-card .tag {
      display: inline-block;
      padding: 0.35rem 0.75rem;
      border-radius: 999px;
      background: rgba(114, 221, 255, 0.1);
      color: var(--accent);
      font-size: 0.75rem;
      font-weight: 700;
    }

    .flow-diagram {
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
      padding: 2rem;
      border-radius: 1.2rem;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .flow-step {
      flex: 1;
      min-width: 140px;
      text-align: center;
      padding: 1rem;
      border-radius: 1rem;
      background: rgba(114, 221, 255, 0.05);
      border: 1px solid rgba(114, 221, 255, 0.15);
    }

    .flow-step .step-icon {
      font-size: 1.5rem;
      margin-bottom: 0.5rem;
    }

    .flow-step .step-title {
      display: block;
      font-weight: 700;
      font-size: 0.9rem;
      margin-bottom: 0.25rem;
      color: var(--text);
    }

    .flow-step .step-desc {
      font-size: 0.8rem;
      color: var(--muted);
    }

    .flow-arrow {
      font-size: 1.5rem;
      color: var(--accent);
    }

    .category-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
    }

    .category-item {
      padding: 1rem 1.25rem;
      border-radius: 1rem;
      border: 1px solid rgba(114, 221, 255, 0.2);
      background: rgba(114, 221, 255, 0.05);
      text-align: center;
      font-weight: 700;
      color: var(--text);
    }

    .detection-grid {
      display: grid;
      gap: 1.25rem;
      margin-top: 2rem;
    }

    .detection-card {
      padding: 1.5rem;
      border-radius: 1.2rem;
      border: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(255, 255, 255, 0.02);
    }

    .detection-card.verified {
      border-color: rgba(0, 245, 196, 0.3);
      background: rgba(0, 245, 196, 0.05);
    }

    .detection-card.misleading {
      border-color: rgba(255, 184, 48, 0.3);
      background: rgba(255, 184, 48, 0.05);
    }

    .detection-card.fake {
      border-color: rgba(255, 77, 109, 0.3);
      background: rgba(255, 77, 109, 0.05);
    }

    .detection-card h3 {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-size: 1.2rem;
      margin-bottom: 0.75rem;
    }

    .detection-card .badge {
      font-size: 1.5rem;
    }

    .color-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 1rem;
    }

    .color-swatch {
      text-align: center;
    }

    .color-box {
      width: 100%;
      height: 80px;
      border-radius: 1rem;
      margin-bottom: 0.75rem;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .color-code {
      display: block;
      font-family: "Sora", sans-serif;
      font-weight: 700;
      font-size: 0.9rem;
      margin-bottom: 0.25rem;
    }

    .color-label {
      font-size: 0.85rem;
      color: var(--muted);
    }

    .feature-list {
      display: grid;
      gap: 1.25rem;
    }

    .feature-item {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 1.25rem;
      padding: 1.5rem;
      border-radius: 1.2rem;
      border: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(255, 255, 255, 0.02);
    }

    .feature-number {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2.5rem;
      height: 2.5rem;
      border-radius: 0.75rem;
      background: linear-gradient(135deg, rgba(114, 221, 255, 0.2), rgba(73, 177, 255, 0.2));
      border: 1px solid rgba(114, 221, 255, 0.3);
      font-family: "Sora", sans-serif;
      font-weight: 800;
      color: var(--accent);
      flex-shrink: 0;
    }

    .feature-content h3 {
      font-size: 1.1rem;
      margin-bottom: 0.5rem;
    }

    .feature-content p {
      color: var(--muted);
      margin: 0;
    }

    .business-section {
      padding: 3rem 2rem;
      border-radius: 1.5rem;
      background: linear-gradient(135deg, rgba(114, 221, 255, 0.08), rgba(73, 177, 255, 0.05));
      border: 1px solid rgba(114, 221, 255, 0.2);
    }

    .business-section h2 {
      text-align: center;
      margin-bottom: 1rem;
    }

    .business-section .subtitle {
      text-align: center;
      color: var(--muted-strong);
      max-width: 600px;
      margin: 0 auto 2rem;
    }

    .business-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1.25rem;
      margin-top: 2rem;
    }

    .business-card {
      padding: 1.5rem;
      border-radius: 1.2rem;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .business-card .icon {
      font-size: 2rem;
      margin-bottom: 1rem;
    }

    .business-card h3 {
      font-size: 1.1rem;
      margin-bottom: 0.75rem;
    }

    .business-card p {
      color: var(--muted);
      font-size: 0.9rem;
      margin-bottom: 0.75rem;
    }

    .business-card .tag {
      display: inline-block;
      padding: 0.35rem 0.75rem;
      border-radius: 999px;
      background: rgba(114, 221, 255, 0.15);
      color: var(--accent);
      font-size: 0.75rem;
      font-weight: 700;
    }

    .roadmap-list {
      display: grid;
      gap: 1.25rem;
    }

    .roadmap-item {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 1.25rem;
      padding: 1.5rem;
      border-radius: 1.2rem;
      border: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(255, 255, 255, 0.02);
    }

    .roadmap-number {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 3rem;
      height: 3rem;
      border-radius: 1rem;
      background: linear-gradient(135deg, rgba(114, 221, 255, 0.2), rgba(73, 177, 255, 0.2));
      border: 1px solid rgba(114, 221, 255, 0.3);
      font-family: "Sora", sans-serif;
      font-weight: 800;
      font-size: 1.2rem;
      color: var(--accent);
      flex-shrink: 0;
    }

    .roadmap-content h3 {
      font-size: 1.1rem;
      margin-bottom: 0.5rem;
    }

    .roadmap-content p {
      color: var(--muted);
      margin: 0;
      font-size: 0.9rem;
    }

    @media (max-width: 820px) {
      .flow-diagram {
        flex-direction: column;
      }

      .flow-arrow {
        transform: rotate(90deg);
      }

      .stack-grid,
      .category-grid,
      .color-grid,
      .business-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <section class="section arch-hero">
    <div class="container">
      <a href="/portfolio" class="back-link">← Back to Portfolio</a>
      
      <div class="arch-header">
        <p class="eyebrow">Product Architecture</p>
        <h1>Pulse<span style="color: var(--accent);">News</span></h1>
        <p class="subtitle">
          A location-aware, AI-powered news platform with real-time fake news detection — built for Web (Next.js 14) and Mobile (React Native Expo).
        </p>

        <div class="tech-badges">
          <span class="tech-badge">Next.js 14</span>
          <span class="tech-badge">React Native Expo</span>
          <span class="tech-badge">Gemini 2.0 Flash</span>
          <span class="tech-badge">Claude Sonnet</span>
          <span class="tech-badge">Fake News Detection</span>
          <span class="tech-badge">Supabase</span>
          <span class="tech-badge">FCM Push</span>
          <span class="tech-badge">Google Translate</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Layer 01: Tech Stack -->
  <section class="layer-section">
    <div class="container">
      <div class="layer-header">
        <span class="layer-number">01</span>
        <h2>Tech Stack</h2>
      </div>

      <div class="stack-grid">
        <div class="stack-card">
          <div class="icon">⚡</div>
          <h3>Next.js 14 + Tailwind CSS</h3>
          <p>App Router, server components, API routes. Tailwind for utility-first styling with custom design tokens.</p>
          <span class="tag">Web Frontend</span>
        </div>

        <div class="stack-card">
          <div class="icon">📱</div>
          <h3>React Native Expo</h3>
          <p>Cross-platform iOS & Android app. Shares API routes with the web. Expo Router for navigation.</p>
          <span class="tag">Mobile App</span>
        </div>

        <div class="stack-card">
          <div class="icon">🧠</div>
          <h3>Gemini 2.0 Flash + Grounding</h3>
          <p>Fetches real news from the web via Google Grounding. Powers fake news cross-checking using live search.</p>
          <span class="tag">AI News Engine</span>
        </div>

        <div class="stack-card">
          <div class="icon">✦</div>
          <h3>Claude Sonnet API</h3>
          <p>Generates clean 2-line summaries for every article. Concise, readable, context-aware.</p>
          <span class="tag">Summarisation</span>
        </div>

        <div class="stack-card">
          <div class="icon">🌐</div>
          <h3>Google Cloud Translation</h3>
          <p>Auto-translates headlines, summaries, and fact-check verdicts to Hindi and Punjabi.</p>
          <span class="tag">i18n / Translation</span>
        </div>

        <div class="stack-card">
          <div class="icon">🗄️</div>
          <h3>Supabase</h3>
          <p>Stores user preferences, bookmarks, and reading history. Row-level security for per-user data.</p>
          <span class="tag">Database & Auth</span>
        </div>

        <div class="stack-card">
          <div class="icon">🔔</div>
          <h3>Firebase Cloud Messaging</h3>
          <p>Push notifications for breaking news. Supports web push and native mobile via Expo notifications.</p>
          <span class="tag">Push Notifications</span>
        </div>

        <div class="stack-card">
          <div class="icon">📍</div>
          <h3>ipinfo.io</h3>
          <p>IP-based location fallback when browser geolocation is denied. Returns city, state, country.</p>
          <span class="tag">Location Fallback</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Layer 02: News Feed Logic -->
  <section class="layer-section">
    <div class="container">
      <div class="layer-header">
        <span class="layer-number">02</span>
        <h2>News Feed Logic</h2>
      </div>

      <div class="flow-diagram">
        <div class="flow-step">
          <div class="step-icon">📍</div>
          <span class="step-title">Location</span>
          <span class="step-desc">Browser geo / ipinfo.io</span>
        </div>
        <div class="flow-arrow">→</div>
        <div class="flow-step">
          <div class="step-icon">🌐</div>
          <span class="step-title">Language</span>
          <span class="step-desc">Auto-detect · User override</span>
        </div>
        <div class="flow-arrow">→</div>
        <div class="flow-step">
          <div class="step-icon">🧠</div>
          <span class="step-title">Gemini</span>
          <span class="step-desc">Grounded news fetch</span>
        </div>
        <div class="flow-arrow">→</div>
        <div class="flow-step">
          <div class="step-icon">📰</div>
          <span class="step-title">Feed</span>
          <span class="step-desc">10 local · 10 state · 10 national · 10 global</span>
        </div>
        <div class="flow-arrow">→</div>
        <div class="flow-step">
          <div class="step-icon">✦</div>
          <span class="step-title">Claude</span>
          <span class="step-desc">2-line summaries</span>
        </div>
        <div class="flow-arrow">→</div>
        <div class="flow-step">
          <div class="step-icon">🔍</div>
          <span class="step-title">Fact Check</span>
          <span class="step-desc">Verified / Misleading / Fake</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Layer 03: Categories -->
  <section class="layer-section">
    <div class="container">
      <div class="layer-header">
        <span class="layer-number">03</span>
        <h2>Categories — Sticky Filter Bar</h2>
      </div>

      <p style="color: var(--muted-strong); margin-bottom: 2rem;">
        Users can toggle any category ON / OFF. Active state = filled with accent colour. Persisted to Supabase preferences.
      </p>

      <div class="category-grid">
        <div class="category-item">🏛️ Politics</div>
        <div class="category-item">💼 Tech & Business</div>
        <div class="category-item">🚨 Crime & Safety</div>
        <div class="category-item">⚽ Sports</div>
        <div class="category-item">🎬 Entertainment</div>
        <div class="category-item">🌤️ Weather</div>
      </div>
    </div>
  </section>

  <!-- Layer 04: Fake News Detection -->
  <section class="layer-section">
    <div class="container">
      <div class="layer-header">
        <span class="layer-number">04</span>
        <h2>Fake News Detection</h2>
      </div>

      <p style="color: var(--muted-strong); margin-bottom: 2rem; max-width: 800px;">
        Every article is sent to Gemini API with Google Grounding to cross-check facts against live web sources. The AI returns a structured verdict with a 1-2 line reason, shown as a badge on every news card. Results are also translated into the user's selected language.
      </p>

      <div class="detection-grid">
        <div class="detection-card verified">
          <h3><span class="badge">✅</span> Verified</h3>
          <p style="color: var(--muted); margin: 0;">Green checkmark badge. Article facts confirmed by multiple sources. No special border.</p>
        </div>

        <div class="detection-card misleading">
          <h3><span class="badge">⚠️</span> Misleading</h3>
          <p style="color: var(--muted); margin: 0;">Orange border + note. Partially true but missing context or uses deceptive framing.</p>
        </div>

        <div class="detection-card fake">
          <h3><span class="badge">🚫</span> Fake</h3>
          <p style="color: var(--muted); margin: 0;">Red border + warning banner. Contradicted by credible sources. Prominent user warning shown.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Layer 05: UI Design System -->
  <section class="layer-section">
    <div class="container">
      <div class="layer-header">
        <span class="layer-number">05</span>
        <h2>UI Design System — Dark Modern</h2>
      </div>

      <div class="color-grid">
        <div class="color-swatch">
          <div class="color-box" style="background: #0A0A0F;"></div>
          <span class="color-code">#0A0A0F</span>
          <span class="color-label">Background</span>
        </div>
        <div class="color-swatch">
          <div class="color-box" style="background: #13131A;"></div>
          <span class="color-code">#13131A</span>
          <span class="color-label">Card</span>
        </div>
        <div class="color-swatch">
          <div class="color-box" style="background: #6C63FF;"></div>
          <span class="color-code">#6C63FF</span>
          <span class="color-label">Accent</span>
        </div>
        <div class="color-swatch">
          <div class="color-box" style="background: #FF4D6D;"></div>
          <span class="color-code">#FF4D6D</span>
          <span class="color-label">Fake / Breaking</span>
        </div>
        <div class="color-swatch">
          <div class="color-box" style="background: #FFB830;"></div>
          <span class="color-code">#FFB830</span>
          <span class="color-label">Misleading</span>
        </div>
        <div class="color-swatch">
          <div class="color-box" style="background: #00F5C4;"></div>
          <span class="color-code">#00F5C4</span>
          <span class="color-label">Verified</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Layer 06: Extra Features -->
  <section class="layer-section">
    <div class="container">
      <div class="layer-header">
        <span class="layer-number">06</span>
        <h2>Extra Features</h2>
      </div>

      <div class="feature-list">
        <div class="feature-item">
          <div class="feature-number">01</div>
          <div class="feature-content">
            <h3>Smart Search</h3>
            <p>Keyword search powered by Gemini Grounding. Returns real-time results from the web, not a static index.</p>
          </div>
        </div>

        <div class="feature-item">
          <div class="feature-number">02</div>
          <div class="feature-content">
            <h3>Share Sheet</h3>
            <p>Each card has share buttons for WhatsApp, Twitter/X, and Copy Link. Native share API on mobile.</p>
          </div>
        </div>

        <div class="feature-item">
          <div class="feature-number">03</div>
          <div class="feature-content">
            <h3>Bookmarks</h3>
            <p>Save articles to Supabase. Synced across web and mobile. Offline-capable on mobile via Expo SQLite.</p>
          </div>
        </div>

        <div class="feature-item">
          <div class="feature-number">04</div>
          <div class="feature-content">
            <h3>Push Notifications</h3>
            <p>FCM sends breaking news alerts. Web push via service worker. Mobile via Expo Notifications.</p>
          </div>
        </div>

        <div class="feature-item">
          <div class="feature-number">05</div>
          <div class="feature-content">
            <h3>Trending AI Section</h3>
            <p>Gemini analyses the feed to surface top 5 trending topics shown as clickable chips in the header bar.</p>
          </div>
        </div>

        <div class="feature-item">
          <div class="feature-number">06</div>
          <div class="feature-content">
            <h3>Language Switcher</h3>
            <p>Top nav dropdown. Switches entire feed language (English / Hindi / Punjabi) via Google Translate API.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Business Model -->
  <section class="layer-section">
    <div class="container">
      <div class="business-section">
        <h2>Business Model</h2>
        <p class="subtitle">Free for Users. A Marketing Engine for Businesses.</p>

        <p style="color: var(--muted-strong); max-width: 800px; margin: 0 auto 1.5rem; text-align: center;">
          PulseNews is completely free for end users — no subscriptions, no paywalls, no premium tiers. The product grows through reach, not friction. The revenue model operates entirely on the business side, through a location-based marketing engine embedded inside the news feed.
        </p>

        <p style="color: var(--muted-strong); max-width: 800px; margin: 0 auto 2rem; text-align: center;">
          Because PulseNews knows exactly where each user is — their city, state, and region — it can serve hyper-targeted promotional content between news cards. This makes PulseNews a precision marketing channel for businesses that want to reach audiences in a specific geography, not just a broad demographic.
        </p>

        <div class="business-grid">
          <div class="business-card">
            <div class="icon">🏙️</div>
            <h3>City-Level Targeting</h3>
            <p>A restaurant in Chandigarh, a coaching institute in Ludhiana, or a real estate developer in Noida can run ads that only appear to users in their exact city.</p>
            <span class="tag">Hyperlocal</span>
          </div>

          <div class="business-card">
            <div class="icon">🗺️</div>
            <h3>State-Level Campaigns</h3>
            <p>Political campaigns, state government initiatives, and regional brands can target all users within a state — with messaging relevant to that audience.</p>
            <span class="tag">Regional</span>
          </div>

          <div class="business-card">
            <div class="icon">📍</div>
            <h3>Custom Region Targeting</h3>
            <p>Define any geographic boundary — a district, a tier-2 cluster, a border region. Ads are served only within that custom zone, making spend highly efficient.</p>
            <span class="tag">Custom Zone</span>
          </div>

          <div class="business-card">
            <div class="icon">📰</div>
            <h3>In-Feed Native Ads</h3>
            <p>Promotional cards appear between news articles, styled to match the feed. Non-intrusive, contextual, and significantly higher engagement than banner ads.</p>
            <span class="tag">Native Format</span>
          </div>
        </div>

        <p style="color: var(--muted-strong); max-width: 800px; margin: 2rem auto 0; text-align: center;">
          <strong style="color: var(--text);">Why this works:</strong> Most digital ad platforms charge for broad reach with poor local precision. PulseNews inverts this — the product is built around location from the ground up, making geographic targeting a core capability rather than an add-on filter. For local businesses, this means every rupee of ad spend reaches only the people who can actually walk through their door.
        </p>
      </div>
    </div>
  </section>

