---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Active Portfolio 2025–26" description="Building AI agents, automation systems, and real products.">
  <style>
    .portfolio-hero {
      padding-top: 5.9rem;
      padding-bottom: 3rem;
    }

    .portfolio-intro {
      max-width: 68ch;
      margin: 0 auto;
      text-align: center;
    }

    .portfolio-intro h1 {
      font-size: clamp(2.5rem, 5vw, 4.5rem);
      margin-bottom: 1.5rem;
    }

    .portfolio-intro .lead {
      font-size: clamp(1.1rem, 2vw, 1.4rem);
      color: var(--muted-strong);
      margin-bottom: 2rem;
      line-height: 1.5;
    }

    .portfolio-stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 1.5rem;
      margin-top: 2.5rem;
    }

    .stat-card {
      text-align: center;
      padding: 1.5rem 1rem;
    }

    .stat-card .number {
      display: block;
      font-family: "Sora", sans-serif;
      font-size: clamp(2rem, 3vw, 2.8rem);
      font-weight: 800;
      color: var(--accent);
      margin-bottom: 0.5rem;
    }

    .stat-card .label {
      color: var(--muted);
      font-size: 0.9rem;
    }

    .project-section {
      padding: 4rem 0;
    }

    .project-card {
      display: grid;
      gap: 2rem;
      grid-template-columns: 1fr 1.2fr;
      align-items: start;
      margin-bottom: 3rem;
    }

    .project-sidebar {
      position: sticky;
      top: 6rem;
    }

    .project-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 1rem;
      border-radius: 999px;
      font-size: 0.85rem;
      font-weight: 700;
      margin-bottom: 1rem;
    }

    .project-badge.active {
      background: rgba(114, 221, 255, 0.12);
      border: 1px solid rgba(114, 221, 255, 0.3);
      color: var(--accent);
    }

    .project-badge.complete {
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.15);
      color: var(--muted-strong);
    }

    .project-badge .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: currentColor;
    }

    .project-status-list {
      list-style: none;
      padding: 0;
      margin: 1.5rem 0;
      display: grid;
      gap: 0.75rem;
    }

    .project-status-list li {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      font-size: 0.9rem;
      color: var(--muted-strong);
    }

    .project-status-list li::before {
      content: "✓";
      flex-shrink: 0;
      width: 1.2rem;
      height: 1.2rem;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: rgba(114, 221, 255, 0.15);
      color: var(--accent);
      font-size: 0.75rem;
      margin-top: 0.1rem;
    }

    .project-status-list li.in-progress::before {
      content: "⟳";
      background: rgba(255, 184, 48, 0.15);
      color: #FFB830;
    }

    .project-links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-top: 1.5rem;
    }

    .project-link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.7rem 1.2rem;
      border-radius: 999px;
      border: 1px solid rgba(114, 221, 255, 0.2);
      background: rgba(255, 255, 255, 0.04);
      color: var(--muted-strong);
      font-size: 0.9rem;
      font-weight: 700;
      transition: all var(--transition);
    }

    .project-link:hover {
      transform: translateY(-2px);
      border-color: var(--accent);
      background: rgba(114, 221, 255, 0.1);
      color: var(--text);
    }

    .project-content h2 {
      font-size: clamp(1.8rem, 3vw, 2.5rem);
      margin-bottom: 1rem;
    }

    .project-content .project-number {
      display: block;
      font-size: 0.85rem;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 0.5rem;
    }

    .project-description {
      font-size: 1.05rem;
      color: var(--muted-strong);
      margin: 1.5rem 0;
      line-height: 1.7;
    }

    .project-details {
      margin-top: 2rem;
    }

    .detail-section {
      margin-bottom: 2rem;
    }

    .detail-section h3 {
      font-size: 1.1rem;
      margin-bottom: 1rem;
      color: var(--text);
    }

    .detail-grid {
      display: grid;
      gap: 1rem;
    }

    .detail-item {
      padding: 1rem 1.2rem;
      border-radius: 1rem;
      border: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(255, 255, 255, 0.02);
    }

    .detail-item strong {
      display: block;
      font-family: "Sora", sans-serif;
      font-size: 0.95rem;
      margin-bottom: 0.4rem;
      color: var(--text);
    }

    .detail-item p {
      font-size: 0.9rem;
      color: var(--muted);
      margin: 0;
    }

    .tech-stack {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 1rem;
      margin-top: 1.5rem;
    }

    .tech-item {
      padding: 1rem;
      border-radius: 1rem;
      border: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(255, 255, 255, 0.02);
    }

    .tech-item strong {
      display: block;
      font-size: 0.9rem;
      margin-bottom: 0.3rem;
      color: var(--text);
    }

    .tech-item span {
      font-size: 0.85rem;
      color: var(--muted);
    }

    .current-state {
      padding: 1.5rem;
      border-radius: 1.2rem;
      border: 1px solid rgba(114, 221, 255, 0.2);
      background: rgba(114, 221, 255, 0.05);
      margin-top: 2rem;
    }

    .current-state h4 {
      font-size: 0.85rem;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 0.75rem;
    }

    .current-state p {
      color: var(--muted-strong);
      margin: 0;
    }

    @media (max-width: 1100px) {
      .project-card {
        grid-template-columns: 1fr;
      }

      .project-sidebar {
        position: static;
      }
    }

    @media (max-width: 640px) {
      .portfolio-stats {
        grid-template-columns: repeat(2, 1fr);
      }

      .tech-stack {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <section class="section portfolio-hero">
    <div class="container">
      <div class="portfolio-intro">
        <p class="eyebrow">Active Portfolio · 2025–26</p>
        <h1>Building AI agents,<br>automation systems,<br>and real products.</h1>
        <p class="lead">
          I am Kamal, 19 — founder of Apex Arc Global. Every project here has real code, real architecture, and active development. Not mockups. Not concepts. Systems.
        </p>

        <div class="portfolio-stats">
          <div class="stat-card glass-card">
            <span class="number">19</span>
            <span class="label">Founder · CEO</span>
          </div>
          <div class="stat-card glass-card">
            <span class="number">03</span>
            <span class="label">Active AI product builds</span>
          </div>
          <div class="stat-card glass-card">
            <span class="number">Live</span>
            <span class="label">GitHub repos · open source</span>
          </div>
          <div class="stat-card glass-card">
            <span class="number">AI-first</span>
            <span class="label">Agents · Automation · Workflows</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section project-section">
    <div class="container">
      <!-- Project 01: Premiere Pro AI Agent -->
      <div class="project-card">
        <div class="project-sidebar glass-card">
          <div class="project-badge active">
            <span class="status-dot"></span>
            Active Build
          </div>
          <h3>Creative Workflow AI · Adobe UXP</h3>
          <p style="color: var(--muted); font-size: 0.9rem; margin: 0.75rem 0;">TypeScript monorepo · Plugin loads</p>

          <div style="margin-top: 1.5rem;">
            <strong style="display: block; font-size: 0.9rem; margin-bottom: 0.75rem; color: var(--text);">⬡ premiere-agent · UXP Panel</strong>
            <ul class="project-status-list">
              <li>Plugin panel loads inside Premiere</li>
              <li>Backend server running</li>
              <li>Reference video analysis live</li>
              <li>Sequence context reading done</li>
              <li class="in-progress">/apply-job route · in progress</li>
            </ul>
          </div>

          <div class="project-links">
            <a href="https://github.com/Kamal01CEO/premiere-agent-workflow" class="project-link" target="_blank" rel="noopener">
              ⬡ View on GitHub →
            </a>
          </div>
        </div>

        <div class="project-content">
          <span class="project-number">Project 01</span>
          <h2>Premiere Pro AI Agent</h2>
          <p class="project-description">
            AI plugin inside Adobe Premiere Pro that reads timeline context, analyzes reference footage, and generates structured edit plans before executing actions.
          </p>

          <div class="project-details">
            <div class="detail-section">
              <h3>AI plugin for editing logic, not just prompts</h3>
              <p style="color: var(--muted-strong); line-height: 1.7;">
                A real TypeScript monorepo built with Adobe UXP Developer Tools. The plugin loads inside Premiere Pro, reads the active sequence context, calls a local backend, and uses AI to analyze reference video — then generates a structured edit plan before changing anything.
              </p>
            </div>

            <div class="detail-grid">
              <div class="detail-item">
                <strong>Problem</strong>
                <p>Editors repeat structured work manually. No tool preserves reusable editing logic across projects.</p>
              </div>
              <div class="detail-item">
                <strong>Solution</strong>
                <p>An AI panel that reads reference style, understands current timeline state, and plans before acting.</p>
              </div>
            </div>

            <div class="detail-section" style="margin-top: 2rem;">
              <h3>Stack</h3>
              <div class="tech-stack">
                <div class="tech-item">
                  <strong>Adobe UXP</strong>
                  <span>Plugin UI inside Premiere Pro</span>
                </div>
                <div class="tech-item">
                  <strong>TypeScript</strong>
                  <span>Monorepo — plugin + backend</span>
                </div>
                <div class="tech-item">
                  <strong>Claude API</strong>
                  <span>Reference analysis + plan generation</span>
                </div>
                <div class="tech-item">
                  <strong>Memory Layer</strong>
                  <span>Reusable edit logic per project</span>
                </div>
              </div>
            </div>

            <div class="current-state">
              <h4>Current state</h4>
              <p>Plugin loads. Backend running. Reference analysis and sequence reading work. The /apply-job action route is active work in progress.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Project 02: Vernacular AI Skilling Engine -->
      <div class="project-card">
        <div class="project-sidebar glass-card">
          <div class="project-badge complete">
            <span class="status-dot"></span>
            Architecture Complete
          </div>
          <h3>Education · WhatsApp AI</h3>
          <p style="color: var(--muted); font-size: 0.9rem; margin: 0.75rem 0;">Full system designed · Build phase next</p>

          <div style="margin-top: 1.5rem;">
            <strong style="display: block; font-size: 0.9rem; margin-bottom: 0.75rem; color: var(--text);">⬡ Vernacular AI · Skilling Flow</strong>
            <ul class="project-status-list">
              <li>System architecture designed</li>
              <li>WhatsApp delivery layer mapped</li>
              <li>AI content + quiz pipeline defined</li>
              <li>n8n automation flows designed</li>
              <li class="in-progress">Implementation · in progress</li>
            </ul>
          </div>

          <div class="project-links">
            <a href="https://github.com/Kamal01CEO/vernacular-ai-skilling-enginei-t" class="project-link" target="_blank" rel="noopener">
              ⬡ GitHub →
            </a>
            <a href="/vernacular-ai" class="project-link">
              ⊞ Architecture →
            </a>
          </div>
        </div>

        <div class="project-content">
          <span class="project-number">Project 02</span>
          <h2>Vernacular AI Skilling Engine</h2>
          <p class="project-description">
            AI-powered skill training for workers in native language — delivered via WhatsApp with automated enrollment, quizzes, progress tracking, and placement orientation.
          </p>

          <div class="project-details">
            <div class="detail-section">
              <h3>Native language AI training built for real access</h3>
              <p style="color: var(--muted-strong); line-height: 1.7;">
                Workers in India face language barriers, low digital access, and weak training pipelines. This system delivers AI-driven skill training in Hindi and Punjabi through WhatsApp — with automated enrollment, progress tracking, and outcome orientation built in.
              </p>
            </div>

            <div class="detail-grid">
              <div class="detail-item">
                <strong>Problem</strong>
                <p>Quality skill training is inaccessible due to language barriers and weak delivery systems.</p>
              </div>
              <div class="detail-item">
                <strong>Solution</strong>
                <p>WhatsApp-first AI skilling in Hindi/Punjabi with automated assessment and tracking.</p>
              </div>
            </div>

            <div class="detail-section" style="margin-top: 2rem;">
              <h3>Stack</h3>
              <div class="tech-stack">
                <div class="tech-item">
                  <strong>Claude API</strong>
                  <span>Native language lesson generation</span>
                </div>
                <div class="tech-item">
                  <strong>WhatsApp API</strong>
                  <span>Primary delivery — no app needed</span>
                </div>
                <div class="tech-item">
                  <strong>n8n</strong>
                  <span>Enrollment, reminders, quiz logic</span>
                </div>
                <div class="tech-item">
                  <strong>SQLite</strong>
                  <span>Progress and completion tracking</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Project 03: PulseNews -->
      <div class="project-card">
        <div class="project-sidebar glass-card">
          <div class="project-badge complete">
            <span class="status-dot"></span>
            Architecture Complete
          </div>
          <h3>Media · AI · Location</h3>
          <p style="color: var(--muted); font-size: 0.9rem; margin: 0.75rem 0;">UI designed · Stack defined · Build next</p>

          <div style="margin-top: 1.5rem;">
            <strong style="display: block; font-size: 0.9rem; margin-bottom: 0.75rem; color: var(--text);">⬡ PulseNews · Live Feed</strong>
            <ul class="project-status-list">
              <li>Product architecture designed</li>
              <li>React Native scaffold complete</li>
              <li>Fake news detection layer defined</li>
              <li>Location + ad model ready</li>
              <li class="in-progress">Development · in progress</li>
            </ul>
          </div>

          <div class="project-links">
            <a href="https://github.com/Kamal01CEO/Pulsenews-Mobile-App" class="project-link" target="_blank" rel="noopener">
              ⬡ GitHub →
            </a>
            <a href="/pulsenews" class="project-link">
              ⊞ Architecture →
            </a>
          </div>
        </div>

        <div class="project-content">
          <span class="project-number">Project 03</span>
          <h2>PulseNews</h2>
          <p class="project-description">
            Location-aware AI news app with real-time summaries, fake news detection, multilingual support, and city-level ad monetization.
          </p>

          <div class="project-details">
            <div class="detail-section">
              <h3>AI news with local intelligence and real monetization</h3>
              <p style="color: var(--muted-strong); line-height: 1.7;">
                PulseNews understands where you are and serves relevant local, state, and national content — with 2-line AI summaries, source verification signals, and multilingual delivery. The business model: hyper-targeted ads for specific cities and regions.
              </p>
            </div>

            <div class="detail-grid">
              <div class="detail-item">
                <strong>Problem</strong>
                <p>Noisy national feeds, poor local relevance, no fake news signals, no language flexibility.</p>
              </div>
              <div class="detail-item">
                <strong>Solution</strong>
                <p>Location-aware AI feed with summaries, verification cues, and city-level ad targeting.</p>
              </div>
            </div>

            <div class="detail-section" style="margin-top: 2rem;">
              <h3>Stack</h3>
              <div class="tech-stack">
                <div class="tech-item">
                  <strong>React Native</strong>
                  <span>Cross-platform mobile app</span>
                </div>
                <div class="tech-item">
                  <strong>Claude API</strong>
                  <span>2-line summaries + fact scoring</span>
                </div>
                <div class="tech-item">
                  <strong>NewsAPI</strong>
                  <span>Feed aggregation by location</span>
                </div>
                <div class="tech-item">
                  <strong>Location Layer</strong>
                  <span>City/state-targeted content + ads</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
